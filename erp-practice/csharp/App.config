<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>

  <!--
    连接字符串放在配置文件里，不要硬编码在代码中。
    换机器 / 换实例 / 换成 SQL 身份验证，只改这一处。

    如果用的是 SQL Server Express 命名实例，改成：
      Server=.\SQLEXPRESS;Database=ERP_Practice;...
    如果用 LocalDB：
      Server=(localdb)\MSSQLLocalDB;Database=ERP_Practice;...
    如果用的是 SQL 账号（sa 等）：
      Server=localhost;Database=ERP_Practice;User Id=sa;Password=你的密码;
  -->
  <connectionStrings>
    <add name="Erp"
         connectionString="Server=localhost;Database=ERP_Practice;Integrated Security=SSPI;TrustServerCertificate=True;Connect Timeout=10;"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
</configuration>
